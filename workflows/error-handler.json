    {
      "parameters": {
        "jsCode": "// Extract error details from the error trigger payload\nconst errorData = $input.item.json;\n\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    workflow_name: errorData.workflow?.name || 'Unknown',\n    workflow_id: errorData.workflow?.id || 'Unknown',\n    error_message: errorData.execution?.error?.message || 'No error message',\n    execution_id: errorData.execution?.id || 'Unknown',\n    timestamp: now,\n    file_path: 'N/A' // Would be extracted from execution data if available\n  }\n}];"
      },
      "id": "extract_error",
      "name": "Extract Error Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        208
      ]
    },
    {
      "parameters": {
        "content": "## 🔴 If Something Goes Wrong\n\nThis workflow runs automatically when the main Blog QA Pipeline fails.\n\nIt captures the error details and logs them for debugging.\n\nThe original blog post file is never modified when an error occurs.",
        "height": 176,
        "width": 560,
        "color": 7
      },
      "id": "sticky_error",
      "name": "Error Handler Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -32,
        -64
      ]
    },
    {
      "parameters": {
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "qa_error_log"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $json.timestamp }}",
            "workflow_name": "={{ $json.workflow_name }}",
